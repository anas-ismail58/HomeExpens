# Copy this file to server/.env and fill in the values.

# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (Neon / local PostgreSQL) ----
# Pooled connection (Neon: host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/family_expense?schema=public
# Direct (non-pooled) connection. Used by Prisma migrations. Same as DATABASE_URL locally.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/family_expense?schema=public
# Separate database for tests (Phase 21)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/family_expense_test?schema=public

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ---- Email (forgot password, Phase 6) ----
# Gmail: smtp.gmail.com, port 465, your Gmail address, and an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Family Expense <no-reply@example.com>"

# ---- Receipts (Render free disk is ephemeral; use Cloudinary in production) ----
UPLOAD_DIR=uploads
CLOUDINARY_URL=
