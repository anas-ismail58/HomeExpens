// Family & Household Expense Management — Prisma schema
// Money: Decimal(14,3) (KWD/BHD use 3 decimals). Dates: Postgres DATE.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel = Vercel runtime
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum MemberType {
  HUSBAND
  WIFE
  CHILD
}

enum OwnerType {
  HOUSEHOLD
  HUSBAND
  WIFE
  CHILD
}

enum Currency {
  SAR
  EGP
  USD
  EUR
  AED
  KWD
  QAR
  BHD
}

/// Father = family admin (full access). Mother/Child act within the permissions the admin grants.
enum UserRole {
  FATHER
  MOTHER
  CHILD
  /// A relative (uncle) the father adds; starts with view-only access the father can widen.
  UNCLE
}

enum PermissionKey {
  VIEW_EXPENSES
  ADD_EXPENSE
  EDIT_EXPENSE
  DELETE_EXPENSE
  VIEW_PAYMENTS
  ADD_PAYMENT
  EDIT_PAYMENT
  DELETE_PAYMENT
  VIEW_REPORTS
  MANAGE_CHILDREN
  /// Service access: each one shows/hides a whole section of the app for the member.
  SERVICE_LESSONS
  SERVICE_RECURRING
  SERVICE_HOUSEHOLD
  /// Salary, income and remaining balance.
  VIEW_INCOME
  /// Children's points: give points for good behavior, approve tasks, redeem rewards.
  EVALUATE_CHILDREN
  /// Create, edit and remove children's tasks.
  MANAGE_CHILD_TASKS
  /// Record mistakes and deduct points or money, within the father's limits.
  PENALIZE_CHILDREN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentCategory {
  BILL
  TUITION
  COURSE
  SUBSCRIPTION
  RENT
  INTERNET
  MOBILE
  INSURANCE
  INSTALLMENT
  LOAN
  OTHER
}

enum PaymentFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
  CUSTOM
}

/// Lifecycle only. Display status (upcoming / due soon / due today / overdue) is derived from dueAt.
enum PaymentState {
  ACTIVE
  PAID
  CANCELLED
}

enum DispatchKind {
  REMINDER
  OVERDUE
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  PAYMENT_REMINDER
  PAYMENT_OVERDUE
  INVITATION
  PERMISSION_CHANGE
  FAMILY_EVENT
  /// A member asked the father to reset their password.
  PASSWORD_RESET_REQUEST
  /// Points, tasks, penalties and rewards; relatedEntityId is the child's FamilyMember id.
  CHILD_POINTS
}

enum Language {
  ar
  en
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum DigitStyle {
  LATN // 123
  ARAB // ١٢٣
}

enum PaymentMethodType {
  CASH
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  APPLE_PAY
  MADA
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

// ───────────────────────── Auth ─────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  /// Family the user belongs to. Null once removed from a family.
  familyId     String?   @db.Uuid
  role         UserRole  @default(FATHER)
  /// Links a CHILD login to its FamilyMember record (scopes the child to its own data).
  memberId     String?   @unique @db.Uuid
  profileImage String?
  timezone     String    @default("Asia/Riyadh")
  isActive     Boolean   @default(true)
  /// Platform operator: sees every family and user and can enter any family as its admin without a
  /// password. Only granted from the server (npm run superadmin), never through the API.
  isSuperAdmin Boolean   @default(false)
  /// Authenticator-app (TOTP) secret, AES-GCM encrypted. Required for super admin sign-in.
  totpSecret   String?
  /// Last accepted 30-second TOTP step, so a code can't be used twice.
  totpLastStep Int?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedFamily         Family?              @relation("FamilyOwner")
  family              Family?              @relation("FamilyUsers", fields: [familyId], references: [id], onDelete: SetNull)
  member              FamilyMember?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  permissions         UserPermission[]     @relation("PermissionHolder")
  grantedPermissions  UserPermission[]     @relation("PermissionGranter")
  sentInvitations     FamilyInvitation[]   @relation("InvitationSender")
  acceptedInvitations FamilyInvitation[]   @relation("InvitationAcceptor")
  createdExpenses     Expense[]            @relation("ExpenseCreator")
  createdIncomes      Income[]             @relation("IncomeCreator")
  createdPayments     Payment[]            @relation("PaymentCreator")
  assignedPayments    Payment[]            @relation("PaymentAssignee")
  lastPaidPayments    Payment[]            @relation("PaymentLastPaidBy")
  paymentRecords      PaymentRecord[]
  paymentDispatches   PaymentReminder[]
  notifications       Notification[]
  pushTokens          PushToken[]
  attachments         Attachment[]
  privateEntries      PrivateEntry[]
  heldWallets         Wallet[]             @relation("WalletHolder")
  createdWallets      Wallet[]             @relation("WalletCreator")
  walletSpending      WalletSpender[]
  walletEntries       WalletEntry[]
  createdChildTasks   ChildTask[]          @relation("ChildTaskCreator")
  completedChildTasks ChildTask[]          @relation("ChildTaskCompleter")
  reviewedChildTasks  ChildTask[]          @relation("ChildTaskReviewer")
  pointEntries        ChildPointEntry[]    @relation("PointEntryCreator")
  voidedPointEntries  ChildPointEntry[]    @relation("PointEntryVoider")
  auditLogs           AuditLog[]

  @@index([familyId, isActive])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Wrong codes entered; the code stops working after 5.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────── Family & settings ─────────────────────────

model Family {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @unique @db.Uuid
  name      String
  currency  Currency   @default(EGP)
  timezone  String     @default("Asia/Riyadh")
  language  Language   @default(ar)
  theme     Theme      @default(SYSTEM)
  digits    DigitStyle @default(LATN)
  showHijri Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  owner             User                 @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users             User[]               @relation("FamilyUsers")
  invitations       FamilyInvitation[]
  payments          Payment[]
  paymentRecords    PaymentRecord[]
  notifications     Notification[]
  teachers          Teacher[]
  attachments       Attachment[]
  wallets           Wallet[]
  members           FamilyMember[]
  categories        Category[]
  paymentMethods    PaymentMethod[]
  expenses          Expense[]
  incomes           Income[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]
  recurringIncomes  RecurringIncome[]
  savingsGoals      SavingsGoal[]
  rewardSettings    ChildRewardSettings?
  pointRules        PointRule[]
  childTasks        ChildTask[]
  pointEntries      ChildPointEntry[]
  auditLogs         AuditLog[]

  @@map("families")
}

model FamilyMember {
  id           String     @id @default(uuid()) @db.Uuid
  familyId     String     @db.Uuid
  name         String
  type         MemberType
  dateOfBirth  DateTime?  @db.Date
  profileImage String?
  notes        String?
  school       String? // CHILD only
  grade        String? // CHILD only
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  incomes           Income[]
  recurringExpenses RecurringExpense[]
  recurringIncomes  RecurringIncome[]
  budgetCategories  BudgetCategory[]
  user              User?
  payments          Payment[]
  invitations       FamilyInvitation[]
  childTasks        ChildTask[]
  pointEntries      ChildPointEntry[]

  @@index([familyId, type])
  @@index([familyId, isActive])
  @@map("family_members")
}

// ───────────────────────── Categories & payment methods ─────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @db.Uuid
  key       String? // stable key for seeded defaults, e.g. "food"
  nameAr    String
  nameEn    String
  icon      String?
  color     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subcategories     Subcategory[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgetCategories  BudgetCategory[]

  @@unique([familyId, key])
  @@index([familyId, isActive])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  key        String?
  nameAr     String
  nameEn     String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive])
  @@map("subcategories")
}

model PaymentMethod {
  id        String            @id @default(uuid()) @db.Uuid
  familyId  String            @db.Uuid
  type      PaymentMethodType
  nameAr    String
  nameEn    String
  isDefault Boolean           @default(false)
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@index([familyId, isActive])
  @@map("payment_methods")
}

// ───────────────────────── Transactions ─────────────────────────

model Expense {
  id                 String    @id @default(uuid()) @db.Uuid
  familyId           String    @db.Uuid
  ownerType          OwnerType
  memberId           String?   @db.Uuid // null when ownerType = HOUSEHOLD
  categoryId         String    @db.Uuid
  subcategoryId      String?   @db.Uuid
  paymentMethodId    String?   @db.Uuid
  /// In `currency` as entered (e.g. a lesson paid in USD).
  amount             Decimal   @db.Decimal(14, 3)
  /// Currency of `amount`. Null = the family currency.
  currency           Currency?
  /// `amount` in the family currency at the rate of the day it was entered; totals add this up.
  /// Null = same as `amount` (entered in the family currency).
  familyAmount       Decimal?  @db.Decimal(14, 3)
  description        String?
  date               DateTime  @db.Date
  occurredAt         DateTime?
  isRecurring        Boolean   @default(false)
  recurringExpenseId String?   @db.Uuid
  receiptUrl         String?
  notes              String?
  createdById        String?   @db.Uuid
  /// Lessons: who taught it and the subject (a list key like "math", or free text).
  teacherId          String?   @db.Uuid
  subject            String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teacher          Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attachments      Attachment[]
  paymentRecords   PaymentRecord[]   @relation("PaymentRecordExpense")
  walletEntry      WalletEntry?
  pointEntry       ChildPointEntry?
  createdBy        User?             @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  family           Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member           FamilyMember?     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory      Subcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  payments         Payment[]

  @@unique([recurringExpenseId, date]) // idempotent recurring generation
  @@index([familyId, date])
  @@index([familyId, ownerType, date])
  @@index([familyId, memberId, date])
  @@index([familyId, categoryId, date])
  @@index([familyId, deletedAt])
  @@index([familyId, createdById])
  @@map("expenses")
}

model Income {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @db.Uuid
  memberId          String?   @db.Uuid
  amount            Decimal   @db.Decimal(14, 3)
  /// Currency of `amount`. Null = the family currency.
  currency          Currency?
  source            String
  description       String?
  date              DateTime  @db.Date
  isRecurring       Boolean   @default(false)
  recurringIncomeId String?   @db.Uuid
  notes             String?
  createdById       String?   @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy       User?            @relation("IncomeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member          FamilyMember?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  recurringIncome RecurringIncome? @relation(fields: [recurringIncomeId], references: [id], onDelete: SetNull)

  @@unique([recurringIncomeId, date])
  @@index([familyId, date])
  @@index([familyId, deletedAt])
  @@map("incomes")
}

model RecurringExpense {
  id              String    @id @default(uuid()) @db.Uuid
  familyId        String    @db.Uuid
  ownerType       OwnerType
  memberId        String?   @db.Uuid
  categoryId      String    @db.Uuid
  subcategoryId   String?   @db.Uuid
  paymentMethodId String?   @db.Uuid
  amount          Decimal   @db.Decimal(14, 3)
  /// Currency of `amount`. Null = the family currency.
  currency        Currency?
  /// `amount` in the family currency at the rate of the day it was set up. Null = same as `amount`.
  familyAmount    Decimal?  @db.Decimal(14, 3)
  description     String
  frequency       Frequency
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  nextOccurrence  DateTime  @db.Date
  isActive        Boolean   @default(true)
  teacherId       String?   @db.Uuid
  subject         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacher       Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member        FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  expenses      Expense[]
  payments      Payment[]

  @@index([familyId, isActive, nextOccurrence])
  @@map("recurring_expenses")
}

model RecurringIncome {
  id             String    @id @default(uuid()) @db.Uuid
  familyId       String    @db.Uuid
  memberId       String?   @db.Uuid
  amount         Decimal   @db.Decimal(14, 3)
  /// Currency of `amount` (e.g. a salary paid in SAR). Null = the family currency.
  currency       Currency?
  source         String
  description    String?
  frequency      Frequency
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  nextOccurrence DateTime  @db.Date
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family  Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member  FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  incomes Income[]

  @@index([familyId, isActive, nextOccurrence])
  @@map("recurring_incomes")
}

// ───────────────────────── Budgets ─────────────────────────

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  familyId    String   @db.Uuid
  year        Int
  month       Int // 1–12
  totalAmount Decimal  @db.Decimal(14, 3)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items  BudgetCategory[]

  @@unique([familyId, year, month])
  @@map("budgets")
}

/// A budget line. Set categoryId, memberId, or both (e.g. "Omar — Education").
/// At least one must be set (enforced in the service layer).
model BudgetCategory {
  id         String   @id @default(uuid()) @db.Uuid
  budgetId   String   @db.Uuid
  categoryId String?  @db.Uuid
  memberId   String?  @db.Uuid
  amount     Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  budget   Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  member   FamilyMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId, memberId])
  @@index([budgetId])
  @@map("budget_categories")
}

// ───────────────────────── Savings ─────────────────────────

model SavingsGoal {
  id           String    @id @default(uuid()) @db.Uuid
  familyId     String    @db.Uuid
  name         String
  targetAmount Decimal   @db.Decimal(14, 3)
  targetDate   DateTime? @db.Date
  description  String?
  icon         String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  family        Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([familyId, isActive])
  @@map("savings_goals")
}

/// currentAmount of a goal = SUM(contributions.amount). Negative = withdrawal.
model SavingsContribution {
  id        String   @id @default(uuid()) @db.Uuid
  goalId    String   @db.Uuid
  amount    Decimal  @db.Decimal(14, 3)
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@map("savings_contributions")
}

// ───────────────────────── Family access ─────────────────────────

model FamilyInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  familyId     String           @db.Uuid
  email        String
  role         UserRole
  /// For CHILD invitations: the child record the new login represents.
  memberId     String?          @db.Uuid
  /// Shared with the invitee (no email service); high-entropy, single use.
  code         String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String           @db.Uuid
  acceptedById String?          @db.Uuid
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member     FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  invitedBy  User          @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?         @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([email, status])
  @@map("family_invitations")
}

/// Explicit per-member grants. Missing rows fall back to the role defaults; FATHER always has every permission.
model UserPermission {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  key         PermissionKey
  granted     Boolean
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User  @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("PermissionGranter", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@map("user_permissions")
}

// ───────────────────────── Payments & bills ─────────────────────────

/// A bill / fee / subscription. Recurring payments keep one row whose dueDate rolls forward when paid.
model Payment {
  id                 String           @id @default(uuid()) @db.Uuid
  familyId           String           @db.Uuid
  createdById        String           @db.Uuid
  /// The single user who gets this payment's notifications.
  assigneeId         String           @db.Uuid
  memberId           String?          @db.Uuid
  /// Set when the reminder was created together with an expense / recurring expense.
  expenseId          String?          @db.Uuid
  recurringExpenseId String?          @db.Uuid
  /// The teacher a lesson payment goes to.
  teacherId          String?          @db.Uuid
  name               String
  description        String?
  notes              String?
  amount             Decimal          @db.Decimal(14, 3)
  currency           Currency
  category           PaymentCategory  @default(OTHER)
  frequency          PaymentFrequency @default(MONTHLY)
  customIntervalDays Int?
  startDate          DateTime         @db.Date
  /// Current cycle's due date (local to `timezone`) and time "HH:MM".
  dueDate            DateTime         @db.Date
  dueTime            String
  timezone           String
  /// dueDate + dueTime in `timezone`, as a UTC instant.
  dueAt              DateTime
  state              PaymentState     @default(ACTIVE)
  reminderEnabled    Boolean          @default(false)
  /// Preset reminder: N days before the due date at reminderTime. Null = custom reminderAt.
  reminderDaysBefore Int?
  reminderTime       String?
  /// Reminder instant for the current cycle.
  reminderAt         DateTime?
  lastPaidAt         DateTime?
  lastPaidById       String?          @db.Uuid
  cancelledAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  family           Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee         User              @relation("PaymentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  lastPaidBy       User?             @relation("PaymentLastPaidBy", fields: [lastPaidById], references: [id], onDelete: SetNull)
  member           FamilyMember?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  expense          Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  teacher          Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  records          PaymentRecord[]
  dispatches       PaymentReminder[]
  attachments      Attachment[]

  @@index([familyId, deletedAt, state, dueDate])
  @@index([assigneeId])
  @@index([state, reminderAt])
  @@index([state, dueAt])
  @@index([expenseId])
  @@index([recurringExpenseId])
  @@index([teacherId])
  @@map("payments")
}

/// Payment history: one row per paid cycle.
model PaymentRecord {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @db.Uuid
  familyId        String        @db.Uuid
  dueDate         DateTime      @db.Date
  amount          Decimal       @db.Decimal(14, 3)
  paidAt          DateTime      @default(now())
  paidById        String?       @db.Uuid
  expenseId       String?       @db.Uuid
  /// Result of reading the receipt screenshot when this cycle was paid.
  receiptCheck    ReceiptCheck?
  /// Amount and currency read from the screenshot.
  receiptAmount   Decimal?      @db.Decimal(14, 3)
  receiptCurrency String?
  /// The father, when he confirmed the payment although the check failed.
  overriddenById  String?       @db.Uuid
  /// Each check's result: { amount, date, recipient } → "ok" | "bad" | "unknown" | "skipped".
  receiptChecks   Json?

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  paidBy      User?        @relation(fields: [paidById], references: [id], onDelete: SetNull)
  /// The expense recorded when this cycle was paid (null when the payment already had its own expense).
  expense     Expense?     @relation("PaymentRecordExpense", fields: [expenseId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([paymentId, dueDate])
  @@index([familyId, paidAt])
  @@map("payment_records")
}

enum ReceiptCheck {
  /// The amount on the screenshot matches the payment.
  MATCH
  /// A different amount, or the transfer shows as failed.
  MISMATCH
  /// Not a payment screenshot, or no amount could be read.
  UNREADABLE
  /// The same screenshot was already used for another payment.
  DUPLICATE
  /// The scanner wasn't available (no API key, timeout); the payment was not checked.
  UNAVAILABLE
}

/// What the scanner read from a screenshot for a payment, so the same image is only scanned once.
model ReceiptScan {
  id          String       @id @default(uuid()) @db.Uuid
  familyId    String       @db.Uuid
  paymentId   String       @db.Uuid
  sha256      String
  status      ReceiptCheck
  /// Why it didn't match: NOT_A_RECEIPT, AMOUNT_NOT_FOUND, AMOUNT_DIFFERS, TRANSFER_FAILED.
  reason      String?
  amount      Decimal?     @db.Decimal(14, 3)
  currency    String?
  /// Everything the scanner read (date, receiver number and name…); checks are recomputed from it.
  reading     Json?
  /// The teacher name the receiver's first name was compared with (rescanned if it changes).
  teacherName String?
  createdAt   DateTime     @default(now())

  @@unique([paymentId, sha256])
  @@index([familyId])
  @@map("receipt_scans")
}

/// Execution log of server-side reminders. The unique key guarantees one send per cycle and kind.
model PaymentReminder {
  id           String         @id @default(uuid()) @db.Uuid
  paymentId    String         @db.Uuid
  userId       String         @db.Uuid
  dueDate      DateTime       @db.Date
  kind         DispatchKind
  scheduledFor DateTime
  status       DispatchStatus @default(PENDING)
  sentAt       DateTime?
  error        String?
  createdAt    DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paymentId, dueDate, kind])
  @@index([userId])
  @@map("payment_reminders")
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  familyId        String           @db.Uuid
  title           String
  message         String
  type            NotificationType
  relatedEntityId String?          @db.Uuid
  isRead          Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([familyId])
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ───────────────────────── Teachers & attachments ─────────────────────────

/// A tutor or teacher the family pays for lessons.
model Teacher {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @db.Uuid
  name      String
  phone     String?
  subject   String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  payments          Payment[]

  @@index([familyId, deletedAt])
  @@map("teachers")
}

/// A payment screenshot / receipt photo. Stored compressed in the database (no external storage).
model Attachment {
  id              String   @id @default(uuid()) @db.Uuid
  familyId        String   @db.Uuid
  uploadedById    String?  @db.Uuid
  expenseId       String?  @db.Uuid
  paymentId       String?  @db.Uuid
  paymentRecordId String?  @db.Uuid
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  data            Bytes
  /// SHA-256 of `data`, to spot the same screenshot used for two payments.
  sha256          String?
  createdAt       DateTime @default(now())

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentRecord PaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([familyId, sha256])
  @@index([expenseId])
  @@index([paymentId])
  @@map("attachments")
}

// ───────────────────────── Father's private money ─────────────────────────

enum PrivateDirection {
  IN
  OUT
}

/// The father's private money. Visible ONLY to the user who owns it — no role or permission can see
/// another user's entries, and it is never part of family totals or reports.
model PrivateEntry {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  direction PrivateDirection
  amount    Decimal          @db.Decimal(14, 3)
  note      String?
  date      DateTime         @db.Date
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("private_entries")
}

// ───────────────────────── Allowances (عهدة) ─────────────────────────

enum WalletEntryType {
  TOPUP
  SPEND
}

/// An allowance the father gives a family member (e.g. 5,000 for the house). Spending deducts from it.
model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  familyId    String   @db.Uuid
  name        String
  /// The person the money was transferred to.
  holderId    String   @db.Uuid
  createdById String   @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  holder    User            @relation("WalletHolder", fields: [holderId], references: [id], onDelete: Cascade)
  createdBy User            @relation("WalletCreator", fields: [createdById], references: [id], onDelete: Cascade)
  spenders  WalletSpender[]
  entries   WalletEntry[]

  @@index([familyId, isActive])
  @@map("wallets")
}

/// Who may deduct from a wallet (chosen by the father).
model WalletSpender {
  walletId String @db.Uuid
  userId   String @db.Uuid

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([walletId, userId])
  @@map("wallet_spenders")
}

/// Money in (TOPUP) or out (SPEND). A SPEND is also recorded as an expense so family totals include it.
model WalletEntry {
  id          String          @id @default(uuid()) @db.Uuid
  walletId    String          @db.Uuid
  type        WalletEntryType
  amount      Decimal         @db.Decimal(14, 3)
  note        String?
  date        DateTime        @db.Date
  createdById String?         @db.Uuid
  expenseId   String?         @unique @db.Uuid
  createdAt   DateTime        @default(now())

  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([walletId, date])
  @@map("wallet_entries")
}

// ───────────────────────── Children's points, tasks & penalties ─────────────────────────

enum PointRuleKind {
  /// Good behavior worth points.
  BEHAVIOR
  /// A mistake that costs points.
  PENALTY
  /// Something the child can get for points (a trip, screen time…).
  REWARD
}

enum PointEntryKind {
  /// Points for good behavior (a rule or a custom amount).
  AWARD
  /// Points from an approved task.
  TASK
  /// Points or money taken away for a mistake.
  PENALTY
  /// Points spent on a reward.
  REWARD
  /// Points turned into money owed to the child (−points, +amount).
  CONVERT
  /// Money paid to the child from the reward balance; also a family expense.
  PAYOUT
  /// Pocket money given directly; a family expense, no effect on the balances.
  ALLOWANCE
}

enum ChildTaskStatus {
  PENDING
  /// The child (or a parent) marked it done; waiting for a parent to approve.
  COMPLETED
  /// A parent approved it and its points were awarded.
  APPROVED
}

/// The father's rules for the points system. One row per family, created on first use.
model ChildRewardSettings {
  familyId            String   @id @db.Uuid
  /// Money one point is worth when converted, in the family currency.
  pointValue          Decimal  @default(0.5) @db.Decimal(14, 3)
  /// Most points one award or task can give.
  maxAwardPoints      Int      @default(50)
  /// Most points one penalty can take.
  maxPenaltyPoints    Int      @default(20)
  /// Most penalty points one child can lose in a day, across all parents.
  dailyPenaltyLimit   Int      @default(50)
  /// Most money one penalty can take from the reward balance.
  maxPenaltyAmount    Decimal  @default(50) @db.Decimal(14, 3)
  /// Whether a penalty may take the points balance below zero.
  allowNegativePoints Boolean  @default(false)
  updatedById         String?  @db.Uuid
  updatedAt           DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("child_reward_settings")
}

/// A behavior, penalty or reward with its points, set by the father.
model PointRule {
  id        String        @id @default(uuid()) @db.Uuid
  familyId  String        @db.Uuid
  kind      PointRuleKind
  name      String
  /// Always positive; the kind decides whether it adds or takes away.
  points    Int
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  family  Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entries ChildPointEntry[]

  @@index([familyId, kind, isActive])
  @@map("point_rules")
}

model ChildTask {
  id            String          @id @default(uuid()) @db.Uuid
  familyId      String          @db.Uuid
  memberId      String          @db.Uuid
  title         String
  description   String?
  dueDate       DateTime?       @db.Date
  points        Int
  status        ChildTaskStatus @default(PENDING)
  createdById   String?         @db.Uuid
  completedAt   DateTime?
  completedById String?         @db.Uuid
  reviewedAt    DateTime?
  reviewedById  String?         @db.Uuid
  /// Why a parent sent it back.
  reviewNote    String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member      FamilyMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("ChildTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User?             @relation("ChildTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  reviewedBy  User?             @relation("ChildTaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  entries     ChildPointEntry[]

  @@index([familyId, memberId, status])
  @@map("child_tasks")
}

/**
 * The child's ledger. Balances are sums over non-voided rows, never stored:
 * points = SUM(points), reward money = SUM(amount). Rows are voided, not deleted.
 */
model ChildPointEntry {
  id          String         @id @default(uuid()) @db.Uuid
  familyId    String         @db.Uuid
  memberId    String         @db.Uuid
  kind        PointEntryKind
  /// Signed change to the points balance.
  points      Int            @default(0)
  /// Signed change to the money the child has earned but not been paid.
  amount      Decimal        @default(0) @db.Decimal(14, 3)
  /// Money handed to the child (PAYOUT / ALLOWANCE); matches the linked expense.
  cash        Decimal?       @db.Decimal(14, 3)
  reason      String
  ruleId      String?        @db.Uuid
  taskId      String?        @db.Uuid
  expenseId   String?        @unique @db.Uuid
  /// Local calendar day it happened (for daily limits and reports).
  date        DateTime       @db.Date
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  voidedAt    DateTime?
  voidedById  String?        @db.Uuid
  voidReason  String?

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rule      PointRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  task      ChildTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  expense   Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("PointEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?        @relation("PointEntryVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([familyId, memberId, date])
  @@index([taskId])
  @@map("child_point_entries")
}

/// Who changed what in the children's points system. Append-only.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  familyId   String   @db.Uuid
  actorId    String?  @db.Uuid
  /// The child the change is about, when there is one.
  memberId   String?  @db.Uuid
  /// e.g. "points.award", "task.approve", "settings.update".
  action     String
  entityType String
  entityId   String?  @db.Uuid
  details    Json?
  createdAt  DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([familyId, memberId, createdAt])
  @@map("audit_logs")
}
