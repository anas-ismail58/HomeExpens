{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev && npm ci --prefix mobile --include=dev",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "mobile/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/download",
      "destination": "https://expo.dev/artifacts/eas/Jm6bQpfg1Okeu0noKdHrFajkRC8BU7bAb8SYJTmIpps.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/kids-app/((?!_expo/|assets/).*)",
      "destination": "/kids-app/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 5 * * *"
    }
  ]
}
